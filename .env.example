# Copy to .env and fill in what you have. Everything here is optional —
# the pipeline runs on public APIs alone with an empty .env.
#
# Both naming conventions work, so use whichever you already have:
#   LINKEDIN_EMAIL / LINKEDIN_PASSWORD   (service first)
#   EMAIL_LINKEDIN / PASSWORD_LINKEDIN   (field first)

# --- Claude (optional): fit assessments, CV bullets, cover letters -----------
# Needed for `search --llm` and `apply`. Alternatively run `ant auth login`
# and leave this unset — the SDK picks up the stored profile.
ANTHROPIC_API_KEY=
# Override the model if you want to trade quality for cost.
# ANTHROPIC_MODEL=claude-opus-5

# --- LinkedIn (optional) ----------------------------------------------------
# Guest search needs nothing. These are used only when guest search returns
# empty, and they drive a real browser: run `playwright install chromium` first.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- JobStreet Indonesia (optional) -----------------------------------------
# Search needs nothing. Both values are required for the browser fallback.
JOBSTREET_EMAIL=
JOBSTREET_PASSWORD=

# --- FX overrides (optional) ------------------------------------------------
# Rates normally come from fx_to_idr in config/profile.yaml. Override one
# currency here during a rate swing without editing YAML.
# FX_USD_IDR=16300
# FX_EUR_IDR=17600
